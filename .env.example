# =============================================================================
# WorkZen Environment Variables Template (.env.example)
# Copy this file to .env and fill in your keys:
# cp .env.example .env
# =============================================================================

# 1. Hugging Face AI Serverless API (for AI Resume Coach & ATS Report)
# Get free token from: https://huggingface.co/settings/tokens
VITE_HF_API_KEY=hf_your_huggingface_token_here

# 2. Google OAuth Authentication (for Sign in with Google)
# Get Client ID from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

